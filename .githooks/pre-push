#!/bin/sh
# Checks each commit being pushed, never the working tree, which agents edit live. A red is printed, never
# refused (pushes are never gated, fetch/CLAUDE.md); unit tests run by hand, since under load they time out.
repo=$(pwd)
while read -r _ sha _ _; do
	[ "$sha" = 0000000000000000000000000000000000000000 ] && continue
	dir=$(mktemp -d)
	git archive "$sha" | tar -x -C "$dir"
	ln -s "$repo/node_modules" "$dir/node_modules"
	(cd "$dir" && npm run check && npx knip) || echo "pre-push: ${sha%"${sha#???????}"} is red above; pushing anyway"
	rm -rf "$dir"
done
exit 0
